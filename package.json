{
  "name": "pi-sieve",
  "version": "0.5.0",
  "description": "Caller-defined candidate scoring and on-demand retrieval with Jev for Pi agents.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "pi-extension", "jev", "context"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "examples", "README.md", "CONTRIBUTING.md", "PRIVACY.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:history": "node scripts/check-privacy.mjs --history",
    "check:package": "node scripts/check-privacy.mjs --package",
    "check:secrets": "gitleaks git --redact --no-banner --log-level error .",
    "check": "npm run typecheck && npm test && npm run check:privacy && npm run check:package",
    "eval": "node scripts/evaluate.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1 <0.87.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "~5.9.3"
  }
}
